{
    "name": "libpsd",
    "version": "1.0.1",
    "description": "Photoshop (PSD/PSB) decoder",
    "filters":["psddec"],
    "help": "This filter decodes the merged image of Photoshop PSD/PSB documents using psd_sdk.",
    "support": [
        "image"
    ],
    "sources":"https://bevara.ddns.net/sources/libpsd.accessor",
    "filter_source":{
        "psddec" : "dec_psd.c"
    },
    "extension":{
      "psd" : "img",
      "psb" : "img",
      "pdd" : "img"
    },
    "using": ["solver_minimal_1", "solver_1"],
    "patents": {
        "status": "royalty-free",
        "note": "Photoshop documents",
        "checked": "2026-10-16"
    }
}
